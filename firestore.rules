rules_version = '2';

// Données du portfolio en mode « sans serveur » (Firebase Hosting + Firestore + Firebase Auth).
// Lecture publique du contenu ; écriture réservée aux comptes listés dans admins/{uid} (un seul : Sasah).
service cloud.firestore {
  match /databases/{db}/documents {
    function isAdmin() {
      return request.auth != null && exists(/databases/$(db)/documents/admins/$(request.auth.uid));
    }
    function text(field, min, max) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() >= min
        && request.resource.data[field].size() <= max;
    }

    match /site/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /experiences/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /projects/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cv/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Formulaire de contact : n'importe qui peut déposer un message bien formé, seule l'admin les lit.
    match /messages/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'body', 'createdAt'])
        && text('name', 2, 80)
        && text('email', 5, 120)
        && text('subject', 3, 120)
        && text('body', 10, 2000)
        && request.resource.data.createdAt == request.time;
    }

    // Liste des administrateurs : créée par le script d'amorçage, jamais modifiable depuis le site.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
