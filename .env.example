# PostgreSQL
POSTGRES_USER=sasah
POSTGRES_PASSWORD=sasah
POSTGRES_PORT=5433

# Gateway (port exposé en local)
GATEWAY_PORT=8080

# Front : URL de l'API (relative via la gateway en local, absolue en prod Firebase)
VITE_API_URL=/api

# CORS accepté par les services (URL du front en prod, ex. https://sasah.web.app)
CORS_ORIGIN=*

# Espace admin (http://localhost:8080/admin) : mot de passe de connexion (8 caractères minimum).
# Laisser vide désactive toute modification. ADMIN_SECRET signe les jetons (défaut : le mot de passe).
ADMIN_PASSWORD=
ADMIN_SECRET=
